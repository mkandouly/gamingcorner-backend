DATABASE_URL=postgres://postgres:123456@localhost:5432/gamingcorner
JWT_SECRET=replace_with_a_long_random_secret

# Optional: pin the seeded root admin's credentials instead of generating a
# random password (useful for scripted/CI setups). Leave unset for normal
# use - a random password will be printed to the server console on first run.
# ROOT_ADMIN_EMAIL=root@gamingcorner.local
# ROOT_ADMIN_PASSWORD=changeme
